# Database
POSTGRES_DB=ecommerce
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL="postgresql://postgres:postgres@postgres:5432/ecommerce?schema=public"
DIRECT_URL="postgresql://postgres:postgres@postgres:5432/ecommerce"

# JWT
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRATION="7d"

# App
PORT=4000
NODE_ENV=production
FRONTEND_URL=http://your-vps-domain.com

# Mail
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=example@gmail.com
SMTP_PASS=password
MAIL_FROM="E-Commerce Store <example@gmail.com>"

# Upload
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=5242880