# Database (PostgreSQL URL for remote or local database)
DATABASE_URL=postgresql://postgres:password@host:5432/postgres?schema=public
DIRECT_URL=postgresql://postgres:password@host:5432/postgres?schema=public

# JWT Security
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRATION="7d"

# App & Networking
PORT=4000
NODE_ENV=production
# Frontend URL(s) for CORS (can be comma-separated or wildcard e.g. https://yourdomain.com,https://api.yourdomain.com)
FRONTEND_URL=http://localhost:3000

# Mail Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=example@gmail.com
SMTP_PASS=password
MAIL_FROM="PGX Fitness <example@gmail.com>"

# Upload Configuration
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=5242880