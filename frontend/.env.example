# Frontend Production Environment Configuration for Docploy
# -------------------------------------------------------------
# Note: In Next.js, all NEXT_PUBLIC_* variables are compiled directly
# into the client bundle at build time. Set these as Build Arguments or
# Environment Variables in Docploy.

NEXT_PUBLIC_API_URL=https://api.yourdomain.com/api
NEXT_PUBLIC_IMAGE_BASE_URL=https://api.yourdomain.com
NEXT_PUBLIC_STORE_NAME=PGX
NEXT_PUBLIC_WHATSAPP_NUMBER=+18005550199
NEXT_PUBLIC_SITE_URL=https://yourdomain.com

NODE_ENV=production
PORT=3000
HOSTNAME=0.0.0.0
NEXT_TELEMETRY_DISABLED=1
